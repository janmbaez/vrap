POSTGRES_PASSWORD=replace-with-a-long-random-password
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
VRAP_PORT=8080

# Optional Tenable Vulnerability Management integration
TENABLE_ACCESS_KEY=
TENABLE_SECRET_KEY=
